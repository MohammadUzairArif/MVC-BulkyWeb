
<div class="container">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Company List</h2>
        </div>
        <div class="col-6">
            <a asp-controller="Company" asp-action="Upsert" class="btn btn-primary float-end">
                <i class="bi bi-plus-lg"></i> Add New Company
            </a>
        </div>
    </div>

    <table id="tblData" class="table table-bordered table-striped mt-3">
        <thead>
            <tr>
                <th>Name</th>
                <th>Address</th>
                <th>City</th>
                <th>State</th>
                <th>Phone Number</th>
                <th>Actions</th>  @* ✅ Added column for buttons *@
            </tr>
        </thead>
        
    </table>
</div>

@section Scripts {
    <script src="~/js/company.js"></script>
}